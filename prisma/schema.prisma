generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Emotion {
  CALM
  REFRESH
  EXCITEMENT
  AWE
  COMFORT
  LIBERATION
  FOCUS
  ENERGY
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SpaceStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ExperienceStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum SlotStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  CHECKED_IN
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  partnerApplication PartnerApplication?  @relation("Applicant")
  partnerReviews     PartnerApplication[] @relation("PartnerReviewer")
  spaces             Space[]
  bookings           Booking[]
  reports            Report[]             @relation("Reporter")
  moderatedReports   Report[]             @relation("ReportModerator")

  @@index([isDemo, demoExpiresAt])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PartnerApplication {
  id                         String        @id @default(cuid())
  userId                     String        @unique
  operatorName               String        @db.VarChar(80)
  phone                      String        @db.VarChar(30)
  businessRegistrationNumber String        @db.VarChar(30)
  status                     PartnerStatus @default(PENDING)
  reviewerId                 String?
  reviewNote                 String?       @db.VarChar(300)
  createdAt                  DateTime      @default(now())
  reviewedAt                 DateTime?
  updatedAt                  DateTime      @updatedAt

  user     User  @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("PartnerReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Place {
  id          String   @id @default(cuid())
  source      String
  externalId  String
  name        String
  category    String?
  address     String?
  roadAddress String?
  lat         Float
  lng         Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  spaces Space[]

  @@unique([source, externalId])
  @@index([name])
}

model Space {
  id          String      @id @default(cuid())
  ownerId     String
  placeId     String?
  name        String      @db.VarChar(120)
  description String      @db.VarChar(1000)
  typeCode    String      @db.VarChar(30)
  address     String      @db.VarChar(300)
  roadAddress String?     @db.VarChar(300)
  lat         Float
  lng         Float
  rules       String?     @db.VarChar(1000)
  status      SpaceStatus @default(PUBLISHED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  place       Place?       @relation(fields: [placeId], references: [id], onDelete: SetNull)
  experiences Experience[]
  media       SpaceMedia[]

  @@index([ownerId, status])
  @@index([lat, lng])
}

model SpaceMedia {
  id        String   @id @default(cuid())
  spaceId   String
  key       String   @unique
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, sortOrder])
}

model Experience {
  id               String           @id @default(cuid())
  spaceId          String
  title            String           @db.VarChar(120)
  description      String           @db.VarChar(1000)
  durationMinutes  Int
  priceWon         Int              @default(0)
  originalPriceWon Int?
  ambienceTags     String[]
  status           ExperienceStatus @default(PUBLISHED)
  isDemoPublic     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  space    Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  emotions ExperienceEmotion[]
  media    ExperienceMedia[]
  slots    Slot[]

  @@index([spaceId, status])
}

model ExperienceEmotion {
  experienceId String
  emotion      Emotion

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([experienceId, emotion])
  @@index([emotion])
}

model ExperienceMedia {
  id           String   @id @default(cuid())
  experienceId String
  key          String   @unique
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, sortOrder])
}

model Slot {
  id              String     @id @default(cuid())
  experienceId    String
  startsAt        DateTime
  endsAt          DateTime
  bookingClosesAt DateTime
  capacity        Int
  status          SlotStatus @default(OPEN)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([experienceId, startsAt])
  @@index([status, startsAt])
}

model Booking {
  id             String        @id @default(cuid())
  slotId         String
  userId         String
  status         BookingStatus @default(CONFIRMED)
  currentState   String?       @db.VarChar(40)
  desiredEmotion Emotion
  qrTokenHash    String        @unique
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?
  checkedInAt    DateTime?

  slot   Slot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review?

  @@unique([slotId, userId])
  @@index([userId, status, createdAt])
  @@index([slotId, status])
}

model Review {
  id            String       @id @default(cuid())
  bookingId     String       @unique
  afterEmotion  Emotion
  highlightTags String[]
  body          String?      @db.VarChar(500)
  isPublic      Boolean      @default(true)
  status        ReviewStatus @default(PUBLISHED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([status, isPublic, createdAt])
}

model Report {
  id          String       @id @default(cuid())
  reviewId    String
  reporterId  String
  reason      String       @db.VarChar(500)
  status      ReportStatus @default(OPEN)
  moderatorId String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter  User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator User?  @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
}
